# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/scoutx

# Auth
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (emails)
RESEND_API_KEY=re_your_key

# Meta Graph API (Instagram Business OAuth + publishing)
META_GRAPH_APP_ID=your_meta_app_id
META_GRAPH_APP_SECRET=your_meta_app_secret
META_GRAPH_REDIRECT_URI=http://localhost:5000/api/integrations/instagram_business/oauth/callback
META_GRAPH_VERSION=v19.0
META_GRAPH_SCOPES=instagram_basic,instagram_content_publish,pages_show_list

# Fitness AI assessment processing
# Optional: if omitted, backend uses a mock in-process callback for development.
PYTHON_ASSESSOR_URL=http://localhost:8000/api/process
FITNESS_CALLBACK_SECRET=replace_with_callback_shared_secret
FITNESS_CALLBACK_BASE_URL=http://localhost:5000
# Local mode default (same machine for Node + Python). Keep empty.
PYTHON_ASSESSOR_REMOTE_MODE=
# For separated hosting (e.g. Railway), set:
# PYTHON_ASSESSOR_REMOTE_MODE=cloudinary
